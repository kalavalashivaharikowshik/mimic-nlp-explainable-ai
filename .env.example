# Copy to .env (never commit .env) or set these in your hosting dashboard.
# Every value is optional - the defaults work out of the box.

# Where the server downloads its ONNX model from when backend/models/onnx is empty
# (a GitHub release created by the "Export ONNX model" workflow).
# MODEL_BASE_URL=https://github.com/kalavalashivaharikowshik/mimic-nlp-explainable-ai/releases/download/model-v1

# "encoder.onnx" for the float32 encoder (more RAM); default is the int8 one.
# ONNX_ENCODER=

# ONNX Runtime CPU threads (0 = automatic) and low-memory mode (for 512 MB hosts).
# ORT_THREADS=1
# ORT_LOW_MEMORY=true

# Decision threshold on the mortality probability (use the value printed by training/train.py).
# THRESHOLD=0.3

# Only needed if the UI is hosted on a different domain than the API.
# ALLOWED_ORIGINS=https://your-site.example

# Training / export only: original PyTorch weights.
# MODEL_URL=https://drive.google.com/uc?id=1g9yuOIIFgxG-xR4_ri6w6LRpv9OBsvQw

# PORT=8000
