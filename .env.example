# Copy to .env (never commit .env) or set these in your hosting dashboard.
# Every value is optional - the defaults work out of the box.

# Where to get the trained weights when backend/models/hybrid_model.pth is missing.
# A Hugging Face model repo is faster and more reliable than Google Drive.
# MODEL_HF_REPO=your-username/mimic-hybrid-model
# MODEL_URL=https://drive.google.com/uc?id=1g9yuOIIFgxG-xR4_ri6w6LRpv9OBsvQw
# MODEL_SHA256=

# Decision threshold on the mortality probability (use the value printed by training/train.py).
# THRESHOLD=0.3

# Lower-case notes before tokenisation (must match how the model was trained).
# LOWERCASE_TEXT=true

# Only needed if the UI is hosted on a different domain than the API.
# ALLOWED_ORIGINS=https://your-site.example

# PORT=7860
